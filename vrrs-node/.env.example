# Open the IP Webcam app on your phone, tap "Start server", and it will
# show an address like http://192.168.1.42:8080 — use that IP with /video appended.
PHONE_STREAM_URL=http://192.168.1.100:8080/video

# VRRS backend base URL (must be reachable from this PC)
BACKEND_URL=http://127.0.0.1:8000

# Identifiers sent with every alert
CAMERA_ID=PHONE-NODE-1
LOCATION_SPOTTED=Unknown

# Path to the trained YOLO weights
MODEL_PATH=C:\Users\user\runs\detect\svds-plate-detector-final-2\weights\best.pt

# Detection/OCR tuning
DETECT_CONF=0.4
PROCESS_EVERY_N_FRAMES=5
RESEND_COOLDOWN_SECONDS=15
